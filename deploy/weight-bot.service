[Unit]
Description=weight-bot: prywatny bot z wykresem wagi
After=network-online.target
Wants=network-online.target

[Service]
# Own throwaway user; only it can read /var/lib/weight-bot.
DynamicUser=yes
StateDirectory=weight-bot
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/weight-bot.env
Environment=WEIGHT_DB=/var/lib/weight-bot/weight.db
ExecStart=/usr/bin/python3 /opt/weight-bot/weight_bot.py
Restart=always
RestartSec=10

# Game servers run on this machine: a chart must never get in their way.
Nice=10
CPUQuota=50%
MemoryMax=200M

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
