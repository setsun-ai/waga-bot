[Unit]
Description=Waga: prywatny bot z wykresem wagi
After=network-online.target
Wants=network-online.target

[Service]
# Own throwaway user; only it can read /var/lib/waga-bot.
DynamicUser=yes
StateDirectory=waga-bot
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/waga-bot.env
Environment=WAGA_DB=/var/lib/waga-bot/waga.db
ExecStart=/usr/bin/python3 /opt/waga-bot/waga.py
Restart=always
RestartSec=10

# Game servers run on this machine: a chart must never get in their way.
Nice=10
CPUQuota=50%
MemoryMax=200M

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
